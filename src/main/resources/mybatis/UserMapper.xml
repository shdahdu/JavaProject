<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.dao.UserMapper">

    <!-- 结果映射 -->
    <resultMap id="userMap" type="com.example.model.MyUser">
        <id property="id" column="ID"/>
        <result property="username" column="uname"/>
        <result property="password" column="upwd"/>
    </resultMap>

    <!-- 根据用户名查询用户 -->
    <select id="selectByName" parameterType="string" resultMap="userMap">
        SELECT ID, uname, upwd FROM usertable WHERE uname = #{username}
    </select>

    <!-- 注册用户 -->
    <insert id="register" parameterType="com.example.model.MyUser">
        INSERT INTO usertable(uname, upwd)
        VALUES(#{username}, #{password})
    </insert>

</mapper>
